{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "reader",
        "OTA_CHANNEL": "UAT"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "reader",
        "OTA_CHANNEL": "UAT"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "reader",
        "OTA_CHANNEL": "reader-production"
      },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      }
    },
    "kiosk-development": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "kiosk"
      }
    },
    "kiosk-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "kiosk"
      }
    },
    "kiosk-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "kiosk",
        "OTA_CHANNEL": "kiosk-production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json"
      }
    }
  }
}
